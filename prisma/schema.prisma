generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookStatus {
  LIDO
  LENDO
  QUERO_LER
}

model Book {
  id         String     @id @default(cuid())
  userId     String
  title      String
  author     String
  status     BookStatus @default(QUERO_LER)
  year       Int?
  rating     Int?
  review     String?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  genres Genre[]

  @@index([userId])
  @@index([userId, status])
}

model Genre {
  id   String @id @default(cuid())
  name String @unique

  books Book[]
}